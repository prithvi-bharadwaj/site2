# Create a free project at https://app.posthog.com, enable "Cookieless server
# hash mode" in Project Settings > Web analytics, then add these values to the
# Vercel production environment. Avoid setting a local token during normal
# development so your own traffic does not pollute production analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=/garden
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Optional local/host overrides. Vercel environment and commit metadata are
# embedded automatically when these are omitted.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_RELEASE=your_git_sha
